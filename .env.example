# Google Sheets Employees module
# Share the Google Sheet with this service account email.
GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Budget engine Google Sheets connection
# Defaults to the existing spreadsheet ID when omitted.
GOOGLE_BUDGET_SHEET_ID=
GOOGLE_BUDGET_SHEET_NAME=BUDGET

# Supabase backend selected at build/runtime. Configure both together.
# Scope Preview values to the TRACK119 Preview branch/deployment only.
CHAMAH_SUPABASE_URL=
CHAMAH_SUPABASE_PUBLISHABLE_KEY=
