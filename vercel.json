{
  "version": 2,
  "builds": [
    {
      "src": "api/budget.js",
      "use": "@vercel/node"
    },
    {
      "src": "api/budget-test.js",
      "use": "@vercel/node"
    },
    {
      "src": "api/allocations.js",
      "use": "@vercel/node"
    },
    {
      "src": "package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist"
      }
    }
  ],
  "headers": [
    {
      "source": "/service-worker.js",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" },
        { "key": "Service-Worker-Allowed", "value": "/" }
      ]
    },
    {
      "source": "/(.*\\.html)?",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, must-revalidate" }
      ]
    },
    {
      "source": "/(.*\\.(?:js|css))(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, must-revalidate" }
      ]
    }
  ],
  "routes": [
    {
      "src": "/api/budget",
      "dest": "/api/budget.js"
    },
    {
      "src": "/api/budget-test",
      "dest": "/api/budget-test.js"
    },
    {
      "src": "/api/allocations",
      "dest": "/api/allocations.js"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "/$1"
    }
  ]
}
